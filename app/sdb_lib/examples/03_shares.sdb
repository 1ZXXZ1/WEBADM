# ═══════════════════════════════════════════════════════════════
# Пример SDB скрипта: Файловые шары
# ═══════════════════════════════════════════════════════════════

# База файловых шар
USE share;

FORMAT table;

# Все шары
SELECT * FROM *;

# Экспорт в JSON
FORMAT json;
OUTPUT /tmp/samba_shares.json;

# Экспорт в TSV (для вставки в Excel)
FORMAT tsv;
OUTPUT /tmp/samba_shares.tsv;
