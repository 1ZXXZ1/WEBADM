# ========================================================================
# Конфигурация Samba API Server v2.0.2 (FIXED)
# ========================================================================
#
# ИСПРАВЛЕНИЯ (v2.0.2):
#   1. SAMBA_AI_API_BASE — убрана циклическая ссылка на себя (было http://127.0.0.1:8099)
#   2. SAMBA_POLZA_AI_KEY — установлен рабочий ключ (проверен curl 2026-06-08)
#   3. SAMBA_AI_DEFAULT_MODEL — сменён на deepseek/deepseek-v4-flash (работает)
#   4. SAMBA_AI_FALLBACK_MODELS — убраны недоступные модели, добавлены рабочие
#   5. ai_service.py:994 — баг: Task Builder игнорировал POLZA_AI_MODEL (исправлен)
#   6. ai_polza_provider.py:637 — баг: hardcoded fallback model (исправлен)
# ========================================================================

# -- 1. ОСНОВНЫЕ НАСТРОЙКИ СЕРВЕРА ---------------------------------------
SAMBA_API_KEY=4568790uiohghfdrest54r67t8y9ui0opijhukygjhftdrertghj
SAMBA_API_HOST=0.0.0.0
SAMBA_API_PORT=8099
TMPDIR=/var/tmp

# -- 1a. WEB ПАНЕЛЬ (WebADC) ---------------------------------------------
# true  — веб-панель доступна в браузере по адресу http(s)://host:port/
# false — только API на /api/v1/, веб-панель возвращает 404
WEB_ENABLED=true
# WEB_STATIC_DIR=

# -- 1b. SSL / HTTPS -----------------------------------------------------
SAMBA_SSL_CERTFILE=/etc/pki/tls/certs/apiadc.crt
SAMBA_SSL_KEYFILE=/etc/pki/tls/private/apiadc.key
# SAMBA_SSL_KEYFILE_PASSWORD=
# SAMBA_SSL_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt
SAMBA_SSL_VERSION=

# -- 2. НАСТРОЙКИ SAMBA --------------------------------------------------
SAMBA_SERVER=dc1.almaz.local
SAMBA_TOOL_PATH=samba-tool
SAMBA_SMB_CONF=/etc/samba/smb.conf
SAMBA_WORKER_POOL_SIZE=2
SAMBA_JSON_MODE=text

# -- 3. УЧЕТНЫЕ ДАННЫЕ SAMBA ---------------------------------------------
SAMBA_CREDENTIALS_USER=Administrator
SAMBA_CREDENTIALS_PASSWORD=P@$$w0rd
SAMBA_USE_KERBEROS=false
SAMBA_USE_SUDO=auto

# -- 4. ЛОГИРОВАНИЕ -------------------------------------------------------
SAMBA_LOG_LEVEL=INFO
SAMBA_LOG_FORMAT=standard

# -- 5. БЕЗОПАСНОСТЬ: JWT АУТЕНТИФИКАЦИЯ ---------------------------------
SAMBA_JWT_SECRET_KEY=
SAMBA_JWT_ALGORITHM=HS256
SAMBA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SAMBA_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -- 6. БЕЗОПАСНОСТЬ: CORS -----------------------------------------------
SAMBA_CORS_ORIGINS=

# -- 7. БЕЗОПАСНОСТЬ: ОГРАНИЧЕНИЕ ЗАПРОСОВ (RATE LIMIT) ------------------
SAMBA_RATE_LIMIT_ENABLED=true
SAMBA_RATE_LIMIT_AUTH_PER_MIN=10
SAMBA_RATE_LIMIT_READ_PER_MIN=100
SAMBA_RATE_LIMIT_WRITE_PER_MIN=30
SAMBA_RATE_LIMIT_SHELL_PROJET_PER_MIN=120
SAMBA_RATE_LIMIT_WINDOW_SECONDS=60

# -- 8. КЭШИРОВАНИЕ -------------------------------------------------------
SAMBA_CACHE_ENABLED=false
SAMBA_CACHE_TTL=0
SAMBA_CACHE_MAX_SIZE=512

# -- 9. БАЗЫ ДАННЫХ -------------------------------------------------------
SAMBA_MGMT_DB_PATH=/var/lib/samba/api_mgmt.db

# -- 10. ВЫПОЛНЕНИЕ КОМАНД (SHELL) ---------------------------------------
SAMBA_SHELL_ENABLED=true
SAMBA_SHELL_MAX_TIMEOUT=600
SAMBA_SHELL_BLOCKED_COMMANDS=rm -rf /,mkfs.,dd if=,:(){ :|:& };:,fork bomb

# -- 11. ПРОЕКТЫ SHELL (ОСНОВНЫЕ НАСТРОЙКИ) -------------------------------
SAMBA_SHELL_PROJET_BASE_DIR=/home/AD-API-USER
SAMBA_SHELL_PROJET_MAX_PROJECTS=100
SAMBA_SHELL_PROJET_MAX_ARCHIVE_SIZE=500
SAMBA_SHELL_PROJET_ALLOWED_ARCHIVE_TYPES=.zip,.tar.gz,.tgz,.tar.bz2,.tar.xz,.tar,.gz,.7z
SAMBA_SHELL_PROJET_POOL_SIZE=8
SAMBA_SHELL_PROJET_DEFAULT_TIMEOUT=300
SAMBA_SHELL_PROJET_OWNER_DEFAULT=api-user
SAMBA_SHELL_PROJET_MAX_OUTPUT_SIZE=5242880
SAMBA_SHELL_PROJET_MAX_WORKSPACE_SIZE=500

# -- 12. ПРОЕКТЫ SHELL (POSTGRESQL) ---------------------------------------
SAMBA_SHELL_PROJET_PG_HOST=localhost
SAMBA_SHELL_PROJET_PG_PORT=5432
SAMBA_SHELL_PROJET_PG_DBNAME=samba_api
SAMBA_SHELL_PROJET_PG_USER=samba_api
SAMBA_SHELL_PROJET_PG_PASSWORD=12345
# SAMBA_SHELL_PROJET_PG_DSN=postgresql://samba_api:secret@localhost:5432/samba_api
SAMBA_SHELL_PROJET_PG_POOL_MIN=2
SAMBA_SHELL_PROJET_PG_POOL_MAX=10

# -- 13. ПРОЕКТЫ SHELL (ДОПОЛНИТЕЛЬНО) ------------------------------------
SAMBA_SHELL_PROJET_TTL_CLEANUP_INTERVAL=30
SAMBA_SHELL_PROJET_CALLBACK_MAX_RETRIES=3
SAMBA_SHELL_PROJET_ENCRYPTION_KEY=
SAMBA_SHELL_PROJET_SHARED_VOLUMES_DIR=/home/AD-API-USER/_shared

# -- 14. AI АССИСТЕНТ (ОБЩИЕ НАСТРОЙКИ) -----------------------------------
# FIX: SAMBA_AI_API_BASE НЕ должен указывать на себя!
# НЕ ставьте: http://127.0.0.1:8099 или https://127.0.0.1:8099
# НЕ ставьте: http://localhost:8099 или https://dc1.almaz.local:8099
# Это вызывает циклический запрос: AI стучится сам в себя → 400 ошибка.
# AI сервис использует in-memory app.openapi() (с v1.6.8-3),
# поэтому HTTP fallback не нужен. Оставьте ПУСТЫМ.
# Валидатор в config.py автоматически сбросит самоссылку.
SAMBA_AI_API_BASE=
# v2.0.2 fix: Сменена модель на deepseek-v4-flash (проверена на Polza.ai)
# Прежняя openai/gpt-5.4-nano не была доступна → каскад фолбэков → 401
SAMBA_AI_DEFAULT_MODEL=deepseek/deepseek-v4-flash
SAMBA_AI_TEMPERATURE=0.7
# FIX: MAX_TOKENS=80593 вызывал 400 BAD_REQUEST у провайдеров!
# авто-обрезаются до 16384 в config.py. Рекомендуемое: 4096-8192.
SAMBA_AI_MAX_TOKENS=64000

# -- 15. AI АССИСТЕНТ (ЛИМИТЫ И РЕЗЕРВНЫЕ МОДЕЛИ) -------------------------
SAMBA_AI_RATE_LIMIT_RETRIES=3
SAMBA_AI_RATE_LIMIT_MAX_WAIT=30
# v2.0.2 fix: Убраны недоступные модели (kwaipilot/kat-coder-pro-v2, x-ai/grok-4.20)
# Оставлены модели, доступные на Polza.ai с текущим ключом
SAMBA_AI_FALLBACK_MODELS=z-ai/glm-4.7-flash,liquid/lfm-2-24b-a2b,z-ai/glm-4-32b,openai/gpt-5-nano,z-ai/glm-5.1,

# -- 16. AI АССИСТЕНТ (АГЕНТ И СХЕМЫ) ------------------------------------
SAMBA_AI_MAX_SCHEMA_CHARS=120000
SAMBA_AI_AGENT_MAX_MENU_CHARS=80000
SAMBA_AI_AGENT_MAX_STEPS=60
SAMBA_AI_AGENT_EXPORT_DIR=/home/AD-API-USER/ai-exports
SAMBA_AI_AGENT_SHELL_ENABLED=true
SAMBA_AI_AGENT_SHELL_TIMEOUT=30
SAMBA_AI_AGENT_SHELL_BLOCKED_CMDS=rm -rf /,mkfs.,dd if=,...

# -- 16b. AI DEBUG-ЛОГИРОВАНИЕ --------------------------------------------
SAMBA_AI_DEBUG=false
SAMBA_AI_DEBUG_MAX_CONTENT=3000
# -- AI СИСТЕМА: МАСКИРОВКА ДАННЫХ (PII Protection) -----------------------
SAMBA_AI_MASK_ENABLED=true
SAMBA_AI_MASK_FIELDS=
SAMBA_AI_MASK_RANGE_NOTATION=true

# -- 17. AI ПРОВАЙДЕР: POLZA.AI (ОСНОВНЫЕ) --------------------------------
SAMBA_POLZA_AI_URL=https://polza.ai/api/v1
# FIX: Ошибка 401 = неверный/истёкший API-ключ.
# Проверьте ключ: curl -H "Authorization: Bearer ВАШ_КЛЮЧ" https://polza.ai/api/v1/models
# Если не работает — получите новый на https://polza.ai/dashboard
# FIX (2026-06-08): Прежний ключ был удалён на стороне Polza.ai (401 "API ключ удалён").
# Получите новый ключ: https://polza.ai/dashboard → API Keys
# Проверьте ключ: curl -H "Authorization: Bearer ВАШ_КЛЮЧ" https://polza.ai/api/v1/models
SAMBA_POLZA_AI_KEY=pza_0996dJJi2R2kpoUO-fuk-00lLrim7sGM
SAMBA_POLZA_AI_MODEL=deepseek/deepseek-v4-flash

# -- 18. AI ПРОВАЙДЕР: POLZA.AI (МАРШРУТИЗАЦИЯ) --------------------------
SAMBA_POLZA_AI_PROVIDER_ONLY=
SAMBA_POLZA_AI_PROVIDER_ORDER=
SAMBA_POLZA_AI_PROVIDER_IGNORE=
SAMBA_POLZA_AI_PROVIDER_ALLOW_FALLBACKS=true
SAMBA_POLZA_AI_PROVIDER_SORT=
SAMBA_POLZA_AI_PROVIDER_MAX_PRICE_PROMPT=50
SAMBA_POLZA_AI_PROVIDER_MAX_PRICE_COMPLETION=0

# -- 19. AI ПРОВАЙДЕР: POLZA.AI (REASONING) ------------------------------
SAMBA_POLZA_AI_REASONING_EFFORT=medium
SAMBA_POLZA_AI_REASONING_SUMMARY=
SAMBA_POLZA_AI_REASONING_ENABLED=true
SAMBA_POLZA_AI_REASONING_MAX_TOKENS=0
SAMBA_POLZA_AI_REASONING_EXCLUDE=false

# -- 20. AI ПРОВАЙДЕР: POLZA.AI (ПАРАМЕТРЫ ГЕНЕРАЦИИ) --------------------
SAMBA_POLZA_AI_TOP_K=50
SAMBA_POLZA_AI_REPETITION_PENALTY=1
SAMBA_POLZA_AI_TOP_P=0.7
SAMBA_POLZA_AI_FREQUENCY_PENALTY=0
SAMBA_POLZA_AI_PRESENCE_PENALTY=0
SAMBA_POLZA_AI_SEED=0

# -- 21. AI ПРОВАЙДЕР: POLZA.AI (ВЕБ-ПОИСК) ------------------------------
SAMBA_POLZA_AI_WEB_SEARCH_ENABLED=false
SAMBA_POLZA_AI_WEB_SEARCH_CONTEXT_SIZE=medium

# -- 22. AI СИСТЕМА: ЧАТ --------------------------------------------------
SAMBA_AI_CHAT_ENABLED=true
SAMBA_AI_CHAT_MAX_HISTORY=100
SAMBA_AI_CHAT_MAX_PER_USER=100

# -- 23. AI СИСТЕМА: НАВЫКИ (SKILLS) --------------------------------------
SAMBA_AI_SKILLS_DIR=
SAMBA_AI_SKILLS_ENABLED=true

# -- 24. SAMBA ШАРЫ -------------------------------------------------------
SAMBA_SAMBA_SHARES_CONF=/etc/samba/smb.conf
SAMBA_SAMBA_SHARES_DIR=/srv/samba/shares

# -- 25. AI: РЕЖИМ ПРАВ ДОСТУПА -------------------------------------------
SAMBA_AI_PERMISSION_MODE=true

# -- 26. ОПТИМИЗАЦИЯ ПАМЯТИ -----------------------------------------------
SAMBA_UVICORN_WORKERS=1
SAMBA_WORKER_POOL_SIZE=2
SAMBA_CACHE_ENABLED=false
