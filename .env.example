# ═══════════════════════════════════════════════════════════════════════
# WebADC .env — полная конфигурация (pe-a-1.4)
# ═══════════════════════════════════════════════════════════════════════
# Все переменные имеют префикс SAMBA_, кроме явно отмеченных
# (DB_URL, WEB_ENABLED, SAMBA_API_SERVER и т.п.).
#
# Файл ищется в:
#   1. ./.env  (текущая директория, dev-режим)
#   2. /etc/webadc/.env  (production, ALT Linux)
#   3. /etc/apiadc/.env  (legacy compat)


# ───────────────────────────────────────────────────────────────────────
# 1. Единый DB-слой (pe-a-1.4 — SQLAlchemy + Alembic + DuckDB)
# ───────────────────────────────────────────────────────────────────────
# Один URL — вся конфигурация БД. Поддерживаемые бэкенды:
#   sqlite:///DB/app.db                              (default, dev)
#   sqlite:////var/lib/webadc/app.db                 (production absolute path, 4 слеша!)
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
#   mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
#   duckdb:///DB/app.duckdb                          (аналитика, read-only)
DB_URL=sqlite:///DB/app.db
SAMBA_DB_ECHO=false
SAMBA_DB_POOL_SIZE=5
SAMBA_DB_POOL_MAX_OVERFLOW=10
SAMBA_DB_DUCKDB_ENABLED=true


# ───────────────────────────────────────────────────────────────────────
# 2. Server
# ───────────────────────────────────────────────────────────────────────
SAMBA_API_HOST=0.0.0.0
SAMBA_API_PORT=8099
SAMBA_API_KEY=changeme-api-key
SAMBA_LOG_LEVEL=INFO
SAMBA_WORKER_POOL_SIZE=4
SAMBA_TMPDIR=/var/tmp

# Web Panel (SPA на /)
WEB_ENABLED=true
# SAMBA_WEB_STATIC_DIR=  # по умолчанию app/web/static/

# CORS
SAMBA_CORS_ORIGINS=*

# Uvicorn workers (production)
SAMBA_UVICORN_WORKERS=1

# Cache (TTL-based response cache)
SAMBA_CACHE_ENABLED=false
SAMBA_CACHE_TTL=300
SAMBA_CACHE_MAX_SIZE=1000

# Rate limiting
SAMBA_RATE_LIMIT_ENABLED=true
SAMBA_RATE_LIMIT_WINDOW_SECONDS=60
SAMBA_RATE_LIMIT_PER_USER_PER_MIN=200
SAMBA_RATE_LIMIT_READ_PER_MIN=500
SAMBA_RATE_LIMIT_WRITE_PER_MIN=100
SAMBA_RATE_LIMIT_AUTH_PER_MIN=10
SAMBA_RATE_LIMIT_SHELL_PROJET_PER_MIN=30


# ───────────────────────────────────────────────────────────────────────
# 3. SSL/HTTPS (pe-a-1.4)
# ───────────────────────────────────────────────────────────────────────
# Чтобы включить HTTPS — укажите пути к сертификату и ключу.
# Сгенерировать self-signed: sudo webadc ssl generate
SAMBA_SSL_CERTFILE=/etc/webadc/ssl/apiadc.crt
SAMBA_SSL_KEYFILE=/etc/webadc/ssl/apiadc.key
# SAMBA_SSL_KEYFILE_PASSWORD=
# SAMBA_SSL_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt
SAMBA_SSL_VERSION=

# Клиенты (webadc ds, webadc sdb) по умолчанию используют HTTPS
# и НЕ проверяют сертификат (для self-signed). Включить проверку:
SAMBA_API_VERIFY_SSL=0
SAMBA_API_SERVER=https://127.0.0.1:8099


# ───────────────────────────────────────────────────────────────────────
# 4. JWT Authentication (v2.7)
# ───────────────────────────────────────────────────────────────────────
# Если пусто — авто-генерация и сохранение в ~/.samba-api-jwt-secret
SAMBA_JWT_SECRET_KEY=
SAMBA_JWT_ALGORITHM=HS256
SAMBA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 часа
SAMBA_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


# ───────────────────────────────────────────────────────────────────────
# 5. Samba AD DC
# ───────────────────────────────────────────────────────────────────────
SAMBA_TOOL_PATH=samba-tool
SAMBA_LDBSEARCH_PATH=ldbsearch
SAMBA_SMB_CONF=/etc/samba/smb.conf
SAMBA_SAMBA_SHARES_CONF=/etc/samba/smb.conf
SAMBA_SAMBA_SHARES_DIR=/var/lib/samba/ shares

# Сервер Samba AD DC (FQDN)
SAMBA_SERVER=dc1.example.com
# Realm (Kerberos домен)
SAMBA_REALM=EXAMPLE.COM
# Реальное имя DC (для DNS/DRS RPC — НЕ localhost!)
SAMBA_DC_HOSTNAME=
# Роль сервера (dc | member | standalone)
SAMBA_SERVER_ROLE=dc

# LDAP / LDAPI / TDB
SAMBA_LDAP_URL=
SAMBA_LDAPI_URL=
SAMBA_TDB_URL=
SAMBA_TDB_SAM_LDB_PATH=

# Использовать Kerberos для аутентификации samba-tool
SAMBA_USE_KERBEROS=false
# Использовать sudo для samba-tool (требует NOPASSWD в sudoers)
SAMBA_USE_SUDO=false

# Учётные данные для samba-tool (если не используется Kerberos)
SAMBA_CREDENTIALS_USER=Administrator
SAMBA_CREDENTIALS_PASSWORD=


# ───────────────────────────────────────────────────────────────────────
# 6. Shell execution (v1.4.3)
# ───────────────────────────────────────────────────────────────────────
SAMBA_SHELL_ENABLED=true
SAMBA_SHELL_MAX_TIMEOUT=300
SAMBA_SHELL_BLOCKED_COMMANDS=rm -rf /,mkfs,dd if=/dev/zero of=/dev/sd
SAMBA_SHELL_SUDO_PASSWORD=

# Shell Projects (изолированные окружения для пользователей)
SAMBA_SHELL_PROJET_BASE_DIR=/var/lib/webadc/shell-projets
SAMBA_SHELL_PROJET_POOL_SIZE=4
SAMBA_SHELL_PROJET_DEFAULT_TIMEOUT=60
SAMBA_SHELL_PROJET_MAX_PROJECTS=10
SAMBA_SHELL_PROJET_MAX_WORKSPACE_SIZE=104857600
SAMBA_SHELL_PROJET_MAX_ARCHIVE_SIZE=52428800
SAMBA_SHELL_PROJET_ALLOWED_ARCHIVE_TYPES=tar,gz,tgz,zip
SAMBA_SHELL_PROJET_ENCRYPTION_KEY=
SAMBA_SHELL_PROJET_OWNER_DEFAULT=root
SAMBA_SHELL_PROJET_SHARED_VOLUMES_DIR=/var/lib/webadc/shared-volumes
SAMBA_SHELL_PROJET_CALLBACK_MAX_RETRIES=3
SAMBA_SHELL_PROJET_TTL_CLEANUP_INTERVAL=3600

# PostgreSQL для shell-проектов (legacy, если DB_URL=postgresql://...)
SAMBA_SHELL_PROJET_PG_HOST=localhost
SAMBA_SHELL_PROJET_PG_PORT=5432
SAMBA_SHELL_PROJET_PG_DBNAME=samba_api
SAMBA_SHELL_PROJET_PG_USER=samba_api
SAMBA_SHELL_PROJET_PG_PASSWORD=12345
SAMBA_SHELL_PROJET_PG_POOL_MIN=2
SAMBA_SHELL_PROJET_PG_POOL_MAX=10
SAMBA_SHELL_PROJET_PG_DSN=


# ───────────────────────────────────────────────────────────────────────
# 7. Backup
# ───────────────────────────────────────────────────────────────────────
SAMBA_BACKUP_DIR=/var/backups/webadc


# ───────────────────────────────────────────────────────────────────────
# 8. Bulk operations
# ───────────────────────────────────────────────────────────────────────
SAMBA_BULK_MAX_ROWS=1000


# ───────────────────────────────────────────────────────────────────────
# 9. AI Chat (v2.7)
# ───────────────────────────────────────────────────────────────────────
SAMBA_AI_CHAT_ENABLED=true
SAMBA_AI_CHAT_MAX_HISTORY=20
SAMBA_AI_CHAT_MAX_PER_USER=100
SAMBA_AI_DEFAULT_MODEL=
SAMBA_AI_FALLBACK_MODELS=
SAMBA_AI_MAX_TOKENS=16384
SAMBA_AI_TEMPERATURE=0.7
SAMBA_AI_PERMISSION_MODE=strict
SAMBA_AI_API_BASE=
SAMBA_AI_DEBUG=false
SAMBA_AI_DEBUG_MAX_CONTENT=2000
SAMBA_AI_RATE_LIMIT_RETRIES=3
SAMBA_AI_RATE_LIMIT_MAX_WAIT=30
SAMBA_AI_MAX_SCHEMA_CHARS=20000

# AI Data Masker (защита чувствительных данных)
SAMBA_AI_MASK_ENABLED=true
SAMBA_AI_MASK_FIELDS=password,secret,token,api_key,private_key
SAMBA_AI_MASK_RANGE_NOTATION=false

# AI Skills
SAMBA_AI_SKILLS_ENABLED=true
SAMBA_AI_SKILLS_DIR=app/skills

# AI Agent (autonomous shell execution)
SAMBA_AI_AGENT_SHELL_ENABLED=false
SAMBA_AI_AGENT_SHELL_TIMEOUT=60
SAMBA_AI_AGENT_MAX_STEPS=10
SAMBA_AI_AGENT_MAX_MENU_CHARS=2000
SAMBA_AI_AGENT_SHELL_BLOCKED_CMDS=rm -rf /,mkfs,dd
SAMBA_AI_AGENT_API_TIMEOUT=30
SAMBA_AI_AGENT_EXPORT_DIR=/tmp/ai-agent-exports


# ───────────────────────────────────────────────────────────────────────
# 10. POLZA AI Provider (LLM backend)
# ───────────────────────────────────────────────────────────────────────
SAMBA_POLZA_AI_URL=https://api.polza.ai/v1
SAMBA_POLZA_AI_API_KEY=
SAMBA_POLZA_AI_MODEL=glm-4.5
SAMBA_POLZA_AI_REASONING_MODEL=
SAMBA_POLZA_AI_REASONING_EFFORT=medium
SAMBA_POLZA_AI_REASONING_SUMMARY=auto
SAMBA_POLZA_AI_REASONING_MAX_TOKENS=8192
SAMBA_POLZA_AI_TEMPERATURE=0.7
SAMBA_POLZA_AI_TOP_P=1.0
SAMBA_POLZA_AI_TOP_K=50
SAMBA_POLZA_AI_SEED=
SAMBA_POLZA_AI_REPETITION_PENALTY=1.0
SAMBA_POLZA_AI_WEB_SEARCH_ENABLED=false
SAMBA_POLZA_AI_WEB_SEARCH_CONTEXT_SIZE=medium


# ───────────────────────────────────────────────────────────────────────
# 11. Chat system (v2.4 — user-to-user messaging)
# ───────────────────────────────────────────────────────────────────────
SAMBA_CHAT_FILE_DIR=


# ───────────────────────────────────────────────────────────────────────
# 12. Environment encryption (v2.7)
# ───────────────────────────────────────────────────────────────────────
SAMBA_ENV_ENCRYPTION_ENABLED=true


# ───────────────────────────────────────────────────────────────────────
# 13. Logging
# ───────────────────────────────────────────────────────────────────────
# Формат логов: standard | json
SAMBA_LOG_FORMAT=standard
# SAMBA_LOG_FILE=/var/log/webadc/webadc.log
# SAMBA_LOG_MAX_BYTES=10485760
# SAMBA_LOG_BACKUP_COUNT=5


# ═══════════════════════════════════════════════════════════════════════
# Quick start
# ═══════════════════════════════════════════════════════════════════════
#   1. sudo install -m 755 webadc /usr/local/bin/webadc
#   2. pip install -r requirements.txt
#   3. webadc sqldb init         # создаёт DB/app.db + admin/admin
#   4. webadc sqldb upgrade      # применить миграции
#   5. sudo webadc ssl generate  # сгенерировать self-signed
#   6. sudo webadc run           # dev-запуск
#      или
#      sudo systemctl enable --now webadc   # production
#
# Проверка:
#   webadc sqldb status        # обзор БД
#   webadc ssl check           # проверка SSL
#   webadc health              # проверка сервера
